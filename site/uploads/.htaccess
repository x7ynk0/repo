# Yükleme klasöründe PHP çalıştırmayı engelle
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pl|py|cgi|asp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -ExecCGI -Indexes
AddType text/plain .php .phtml
